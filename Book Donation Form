</html><h1>Book Donation Form</h1>

<form>

  <fieldset>
    <legend>Donor details</legend>
    <label>Your name</label>
    <input type="text" id="Name" placeholder="Enter your full name"> <br>
    <label>Donor id</label><br>
    <input type="password" id="pid" placeholder="Your secret password"> <br>
    <Label>Donation Date</Label><br>
    <input type="Date" id="donation date"> <br>

  </fieldset>
  <fieldset>
    <legend>Book details</legend>
    <label>Choose your genre of the book</label>
    <select>
        <option>Fiction</option>
        <option>Romcom</option>
        <option>Science</option>
        <option>History</option>
    </select>
    <label>Book condition</label>
    <input type="radio" name="old">
    <input type="radio" name="used">
    <input type="radio" name="good">
    <label><Textarea> Book title</Textarea></label>
</fieldset>
<fieldset>
    <legend>Drop-off day</legend>
    <select>
        <option>Monday</Option>
        <option>wednesday</option>
        <option>friday</option>
    </select>
</fieldset>
<br>
<input type="submit" value="submit your form">

</form>
